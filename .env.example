# Placeholder values only - NEVER commit real credentials.
# The n8n workflow does not read this file. Use these values when creating
# the IMAP, Postgres, Telegram and OpenAI credentials in the n8n UI.

# IMAP
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USER=your-email@example.com
IMAP_PASSWORD=CHANGE_ME

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=job_applications_db
POSTGRES_USER=n8n_job_tracker
POSTGRES_PASSWORD=CHANGE_ME

# Telegram
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_CHAT_ID=CHANGE_ME

# OpenAI (AI fallback classifier)
# Enter this key in an n8n "OpenAI" credential. The workflow does not read it from here.
OPENAI_API_KEY=CHANGE_ME
